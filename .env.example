# k-map API — Environment Variable Reference
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit a .env file with real credentials to source control.
#
# For local development with Docker Compose, the defaults in this file
# match the docker-compose.yml configuration and require no changes.

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------
# Set to "production" to enable production-mode startup validation.
# In production mode, the API will refuse to start if insecure default
# credentials are detected (e.g. KMAP_POSTGRES_DSN is the local dev default).
#
# KMAP_ENV=production

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
# Bind address for the API server (default: :8080)
KMAP_HTTP_ADDR=:8080

# HTTP timeouts (Go duration strings: 5s, 10s, 1m, etc.)
KMAP_HTTP_READ_HEADER_TIMEOUT=5s
KMAP_HTTP_READ_TIMEOUT=10s
KMAP_HTTP_WRITE_TIMEOUT=15s
KMAP_HTTP_IDLE_TIMEOUT=60s
KMAP_HTTP_SHUTDOWN_TIMEOUT=10s

# ---------------------------------------------------------------------------
# PostgreSQL (application database — tenants, API keys, usage records)
# ---------------------------------------------------------------------------
# Host:port used for dial-timeout health checks (default: localhost:5432)
KMAP_POSTGRES_ADDR=localhost:5432

# Full DSN used for database connections (REQUIRED in production)
# Local dev default — MUST be overridden in production via KMAP_ENV=production
KMAP_POSTGRES_DSN=postgres://kmap:kmap@localhost:5432/kmap?sslmode=disable

# Dial timeout for health checks (default: 2s)
KMAP_POSTGRES_DIAL_TIMEOUT=2s

# ---------------------------------------------------------------------------
# Redis (rate limiting and short-lived geocode cache)
# ---------------------------------------------------------------------------
# Host:port for the Redis instance (default: localhost:6379)
KMAP_REDIS_ADDR=localhost:6379

# Dial timeout for health checks (default: 2s)
KMAP_REDIS_DIAL_TIMEOUT=2s

# TTL for cached geocode responses (default: 5m)
KMAP_CACHE_TTL=5m

# ---------------------------------------------------------------------------
# Nominatim (internal geocoder)
# ---------------------------------------------------------------------------
# Base URL of the internal Nominatim instance (default: http://localhost:8081)
# MUST point to a self-hosted instance. Do not use public shared endpoints.
KMAP_NOMINATIM_URL=http://localhost:8081

# Dial timeout for health checks (default: 2s)
KMAP_NOMINATIM_DIAL_TIMEOUT=2s

# Number of retry attempts on Nominatim failures (default: 1)
KMAP_NOMINATIM_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Maximum requests per minute per tenant API key (default: 60)
KMAP_RATE_LIMIT_RPM=60

# ---------------------------------------------------------------------------
# Nominatim OSM data (used by docker-compose only, not the API binary)
# ---------------------------------------------------------------------------
# PBF download URL for the OSM dataset to import on first run.
# Defaults to Monaco (a small dataset suitable for local dev).
# Override with your target launch region before running compose.
KMAP_NOMINATIM_PBF_URL=https://download.geofabrik.de/europe/monaco-latest.osm.pbf
KMAP_NOMINATIM_REPLICATION_URL=https://download.geofabrik.de/europe/monaco-updates/
